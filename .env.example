RAINDROP_TOKEN=
RAINDROP_COLLECTION_ID=
# gemini / openai / anthropic
LLM_PROVIDER=gemini
LLM_API_KEY=
# 推奨: gemini-3.5-flash-lite / gpt-5.6-luna / claude-haiku-4-5
LLM_MODEL=gemini-3.5-flash-lite
MAX_SUMMARIZE_PER_RUN=10
REQUEST_TIMEOUT_SECONDS=20
USER_AGENT=Tsuyu-mi/0.1
OUTPUT_DIR=docs
# OGP の絶対 URL に使う公開サイト URL（フォークして自分の GitHub Pages に公開する場合は変更する）
SITE_URL=https://unsolublesugar.github.io/tsuyu-mi/
DATA_DIR=data
STATE_DIR=state
LOG_LEVEL=INFO
